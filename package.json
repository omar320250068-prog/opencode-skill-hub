{
  "name": "opencode-skill-hub",
  "version": "0.1.0",
  "description": "MCP server that analyzes projects, discovers skills/agents on GitHub, and installs them into OpenCode workspaces.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opencode-skill-hub": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "opencode",
    "skills",
    "agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.20.0",
    "fs-extra": "^11.4.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
